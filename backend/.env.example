# CodeShift AI Environment Configuration

# Application
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database
DATABASE_URL=sqlite+aiosqlite:///./codeshift.db

# LLM Providers (configured only on the backend — never sent to the browser)
# Supported: mock, gemini, openai
# Use "mock" for local development and unit tests (no paid API calls).
DEFAULT_LLM_PROVIDER=mock

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API (optional alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Execution & Security
ALLOW_DOCKER_EXECUTION=False
DOCKER_TIMEOUT_SECONDS=10
DOCKER_MEMORY_LIMIT=256m
MAX_CODE_CHARS=50000
